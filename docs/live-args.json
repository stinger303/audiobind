{
  "captured_from": "Audiobind 0.18.0-dev2 on Tower behind GluetunVPN (network namespace shared, no published ports), 2026-11-14",
  "network_mode": "container:GluetunVPN",
  "binds": [
    "/mnt/user/data/media/audiobooks-fixed:/output:rw",
    "/mnt/user/appdata/audiobind:/config",
    "/mnt/user/data/media/audiobooks:/library:rw",
    "/mnt/cache_plex/torrents/audiobind-ingest:/ingest:ro"
  ],
  "env": [
    "PUID=99",
    "PGID=100",
    "OUTPUT_ROOT=/output",
    "LIBRARY_ROOT=/library",
    "DRY_RUN=false",
    "AUTO_CONVERT=high",
    "AUDIO_CHANNELS=1",
    "AUDIO_BITRATE=128k",
    "NICE=10",
    "WEB_PORT=8080",
    "TZ=America/Denver",
    "HOST_OUTPUT=/mnt/user/data/media/audiobooks-fixed",
    "STATE_DIR=/config",
    "HOST_LIBRARY=/mnt/user/data/media/audiobooks",
    "SCAN_INTERVAL_MIN=30",
    "JOBS=1",
    "INGEST_DIR=/ingest",
    "QBIT_URL=http://127.0.0.1:8083",
    "ALLOWED_HOSTS=localhost,127.0.0.1,192.168.5.2"
  ],
  "cmd": ["daemon"],
  "labels": {
    "net.unraid.docker.icon": "https://raw.githubusercontent.com/stinger303/audiobind/main/images/audiobind-icon.png",
    "net.unraid.docker.managed": "dockerman",
    "net.unraid.docker.webui": "http://[IP]:[PORT:8080]/"
  },
  "restart": "unless-stopped",
  "ports": {}
}
